<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mcb.jobsradar.fast-refresh</string>
  <key>ProgramArguments</key>
  <array>
		<string>/bin/bash</string>
		<string>__JOBSRADAR_ROOT__/scripts/scheduled-fast-refresh.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__JOBSRADAR_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__JOBSRADAR_HOME__</string>
    <key>NO_PROXY</key>
    <string>127.0.0.1,localhost,::1</string>
    <key>no_proxy</key>
    <string>127.0.0.1,localhost,::1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__JOBSRADAR_ROOT__/logs/scheduled/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__JOBSRADAR_ROOT__/logs/scheduled/launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
