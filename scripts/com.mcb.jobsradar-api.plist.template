<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__JOBSRADAR_HOME__</string>
		<key>NO_PROXY</key>
		<string>127.0.0.1,localhost,::1</string>
		<key>no_proxy</key>
		<string>127.0.0.1,localhost,::1</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.mcb.jobsradar-api</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>set -eu; if [[ -r "$HOME/.config/estate-control-plane.env" ]]; then set -a; source "$HOME/.config/estate-control-plane.env"; set +a; fi; . "$2/scripts/lib/jobsradar-runtime.sh"; jobsradar_configure_database_url; jobsradar_configure_loopback_no_proxy; exec "$1" run api</string>
		<string>jobsradar-api</string>
		<string>__BUN_EXECUTABLE__</string>
		<string>__JOBSRADAR_ROOT__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__JOBSRADAR_HOME__/Library/Logs/jobsradar-api.err.log</string>
	<key>StandardOutPath</key>
	<string>__JOBSRADAR_HOME__/Library/Logs/jobsradar-api.out.log</string>
	<key>WorkingDirectory</key>
	<string>__JOBSRADAR_ROOT__</string>
</dict>
</plist>
