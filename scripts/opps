#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SCRIPT_SOURCE}" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" && pwd)"
  SCRIPT_SOURCE="$(readlink "${SCRIPT_SOURCE}")"
  if [[ "${SCRIPT_SOURCE}" != /* ]]; then
    SCRIPT_SOURCE="${SCRIPT_DIR}/${SCRIPT_SOURCE}"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" && pwd)"
REPO="${OPPS_REPO:-$(dirname "${SCRIPT_DIR}")}"

usage() {
  cat <<'EOF'
Usage:
  opps update [ingest options] Run the deterministic Jobsradar raw ingest
  opps signals                Refresh bookmark hiring/funding company intelligence
  opps list [options]         Print and email the current mixed-source opportunity list
  opps json [options]         Emit the current report as JSON
  opps doctor                 Check the database, API, and browser UI
  opps open                   Open the Latest 50 browser view

Default ingestion includes bounded, paced JobServe contracts. It aborts on fair-use restriction.
`opps update` does not rank, report, email, or fall back to a different scanner.
EOF
}

if [[ ! -d "${REPO}" ]]; then
  printf 'opps: repository not found: %s\n' "${REPO}" >&2
  exit 1
fi

source "${REPO}/scripts/lib/jobsradar-runtime.sh"
jobsradar_configure_database_url
jobsradar_configure_loopback_no_proxy

command="${1:---help}"
if [[ $# -gt 0 ]]; then
  shift
fi
cd "${REPO}"

case "${command}" in
  update)
    exec bun scripts/jobsradar.ts ingest "$@"
    ;;
  list)
    exec bun scripts/list-latest-opportunities.ts --email "$@"
    ;;
  json)
    exec bun scripts/list-latest-opportunities.ts --format json "$@"
    ;;
  signals)
    exec bun run company:signals
    ;;
  doctor)
    failed=0
    if pg_isready --dbname="${DATABASE_URL}" >/dev/null 2>&1; then
      printf 'database  ok\n'
    else
      printf 'database  unavailable\n' >&2
      failed=1
    fi
    if curl --fail --silent --show-error "http://127.0.0.1:3737/api/opportunities?limit=1" >/dev/null; then
      printf 'api       ok\n'
    else
      printf 'api       unavailable\n' >&2
      failed=1
    fi
    if curl --fail --silent --show-error "http://127.0.0.1:32002/" >/dev/null; then
      printf 'ui        http://127.0.0.1:32002/\n'
    else
      printf 'ui        unavailable\n' >&2
      failed=1
    fi
    exit "${failed}"
    ;;
  open)
    exec open "http://127.0.0.1:32002/"
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    printf 'opps: unknown command: %s\n\n' "${command}" >&2
    usage >&2
    exit 2
    ;;
esac
