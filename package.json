{
  "name": "jobfinder",
  "version": "2026.05.02.1",
  "description": "Local Postgres-backed job search pipeline with source fanout, review queues, and CV/application support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauricedesaxe/job-finder.git"
  },
  "keywords": [
    "job-search",
    "scraping",
    "notion",
    "llm",
    "automation",
    "openrouter"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "cv:add-bullet": "bun scripts/cv-add-bullet.ts",
    "cv:draft": "bun scripts/cv-draft.ts",
    "cv:review-draft": "bun scripts/cv-review-draft.ts",
    "applications:list": "bun scripts/list-applications.ts",
    "applications:record": "bun scripts/record-application.ts",
    "api": "bun scripts/api.ts",
    "gen:refresh-registry": "bun -e \"import { allQueueRefreshSourceIds } from './src/pipeline/queueRefresh/registry.ts'; const ids = allQueueRefreshSourceIds(); await Bun.write('prototypes/ui/src/queueRefreshRegistry.ts', '/** Generated — run: bun run gen:refresh-registry */\\nexport const QUEUE_REFRESH_SOURCE_IDS = new Set<string>(' + JSON.stringify(ids, null, 2) + ');\\n');\"",
    "source:availability": "bun scripts/source-availability.ts",
    "source:coverage": "bun scripts/source-coverage.ts",
    "db:check": "bun scripts/db-check.ts",
    "db:create": "bun scripts/db-create.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "jobs:classify": "bun scripts/classify-jobs.ts",
    "jobs:duplicates": "bun scripts/find-duplicate-candidates.ts",
    "jobs:duplicate-review": "bun scripts/review-duplicate-candidate.ts",
    "jobs:export": "bun scripts/export-jobs.ts",
    "jobs:blog-lint": "bun scripts/job-market-blog-lint.ts",
    "jobs:skill-clusters": "bun scripts/skill-clusters.ts",
    "jobs:ingest-pages": "bun scripts/ingest-job-pages.ts",
    "jobs:import-normalized": "bun scripts/import-normalized-jobs.ts",
    "jobs:fast-refresh": "bun scripts/fast-refresh.ts",
    "jobserve:contracts": "bun scripts/list-jobserve-contracts.ts",
    "jobserve:refresh-contracts": "bun scripts/fast-refresh.ts",
    "jobs:queue": "bun scripts/review-queue.ts",
    "jobs:review": "bun scripts/review-job.ts",
    "pipeline:history": "bun scripts/pipeline-history.ts",
    "pipeline:run": "bun scripts/run-pipeline.ts",
    "search": "bun scripts/search-only.ts",
    "search:db": "bun scripts/search-db.ts",
    "source:health": "bun scripts/source-health.ts",
    "source:sweep": "bun scripts/source-sweep.ts",
    "sweeps:list": "bun scripts/list-sweeps.ts",
    "sweeps:save": "bun scripts/save-sweep.ts",
    "scrape": "bun scripts/fast-refresh.ts",
    "legacy:notion:scrape": "bun src/index.ts",
    "legacy:notion:reconcile": "bun src/index.ts --reconcile-only",
    "test": "bun test src/**/__tests__/",
    "test:integration": "bun test src/**/__integration__/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@evilmartians/lefthook": "2.1.4",
    "@types/bun": "1.3.11",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "openai": "6.33.0",
    "@notionhq/client": "2.3.0",
    "pino": "^10.3.1",
    "zod": "4.3.6"
  }
}
